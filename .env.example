# AI explanation (optional)
# If not set, the app will fall back to deterministic explanations.

# OpenAI-compatible API
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL (default: https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional model (default: gpt-4o-mini)
OPENAI_MODEL=

# Safety: limit online AI usage per IP (server-side). Recommended for production.
EXPLAIN_RATE_LIMIT_PER_HOUR=30

# Free/local option (Ollama)
# 1) Install: https://ollama.com/download
# 2) Run: ollama pull llama3.1:8b
# 3) Then set:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b

# Online options (require a free account + API key)
#
# Groq (OpenAI-compatible)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
#
# OpenRouter (OpenAI-compatible)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct
#
# Together (OpenAI-compatible)
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
